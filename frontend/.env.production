# URL relativa da API — injetada no build (Docker ARG ou npm run build).
# Não fixe domínio aqui; use caminho relativo ou ARG VITE_API_URL no Dockerfile.
VITE_API_URL=/backend/public/api/v1

# Domínio principal sem protocolo (opcional; se vazio, detecta pelo hostname).
# Exemplo em EasyPanel/Docker build: VITE_MAIN_DOMAIN=seudominio.com.br
VITE_MAIN_DOMAIN=
