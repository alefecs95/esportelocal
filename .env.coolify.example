# Variáveis para configurar no Coolify (Environment Variables)
# Build pack: Docker Compose | Repositório Git

# Obrigatório — gere com: php artisan key:generate --show
APP_KEY=

# Coolify gera automaticamente (não altere manualmente, salvo necessidade):
# SERVICE_FQDN_APP_80=/
# SERVICE_URL_APP_80=https://seu-dominio-temporario.sslip.io
# SERVICE_PASSWORD_MYSQL=(senha aleatória)

# APP_URL e FRONTEND_URL são definidos automaticamente no entrypoint
# a partir de SERVICE_URL_APP_80 / COOLIFY_URL

APP_DEBUG=false
APP_NAME=SEMEL
DB_DATABASE=semel
DB_USERNAME=semel

# Importação do backup HostGator (escolha UMA opção):

# Opção A — MySQL init (primeiro deploy, volume mysql_init vazio):
#   1. Faça upload do backup.sql para o volume mysql_init (docker-entrypoint-initdb.d)
#   2. Deploy — MySQL importa na primeira inicialização
#   3. Defina RUN_MIGRATIONS=false se o dump já contém schema completo

# Opção B — Import via container app:
#   1. Upload backup.sql para volume db_import como backup.sql
#   2. IMPORT_DB_ON_START=true
#   3. IMPORT_DB_FILE=/docker/database/import/backup.sql
#   4. RUN_MIGRATIONS=false (se dump completo)
#   5. Redeploy

# Opção C — Manual via terminal Coolify:
#   docker exec -i <container_mysql> mysql -u semel -p<PASSWORD> semel < backup.sql

RUN_MIGRATIONS=true
IMPORT_DB_ON_START=false
IMPORT_DB_FILE=/docker/database/import/backup.sql

DIRECTD_API_URL=https://apiv3.directd.com.br/api/CadastroReceitaPessoaFisica
DIRECTD_API_TSE_URL=https://apiv3.directd.com.br/api/TituloLocalVotacao
DIRECTD_API_TOKEN=

TRUSTED_PROXIES=*
SUPER_ADMIN_EMAIL=superadmin@example.com
SUPER_ADMIN_PASSWORD=

# Frontend build (opcional — domínio detectado em runtime se vazio)
VITE_MAIN_DOMAIN=
