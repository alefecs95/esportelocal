# Variáveis para configurar no Coolify (Environment Variables)
# Build pack: Docker Compose | Repositório Git

# Obrigatório — gere com: php artisan key:generate --show
APP_KEY=

# Coolify gera automaticamente (não altere manualmente, salvo necessidade):
# SERVICE_FQDN_APP_80=/
# SERVICE_URL_APP_80=https://seu-dominio-temporario.sslip.io
# SERVICE_PASSWORD_MYSQL=(senha aleatória)
#
# Domínio no serviço APP (não no MySQL). O :80 é a porta INTERNA do nginx:
#   https://esportelocal.com:80,https://www.esportelocal.com:80
#
# Cloudflare (502 Bad Gateway):
#   SSL/TLS → Full (ou Full Strict se o Coolify já tiver certificado)
#   DNS A/AAAA do domínio → IP do servidor Coolify, proxy laranja ok
#   Atribua o domínio só ao serviço "app", nunca ao "mysql"

# APP_URL e FRONTEND_URL — uma URL cada (sem vírgula).
# Coolify pode listar apex + www juntos; o Laravel só aceita um host canônico.
# Se omitir, o entrypoint usa o primeiro domínio de SERVICE_URL_APP_80 / COOLIFY_URL.
#
# APP_URL=https://esportelocal.com/backend/public
# FRONTEND_URL=https://esportelocal.com

APP_DEBUG=false
APP_NAME=SEMEL
DB_DATABASE=semel
DB_USERNAME=semel

# Importação do backup HostGator (escolha UMA opção):

# Opção A — MySQL init (primeiro deploy, volume mysql_init vazio):
#   1. Faça upload do backup.sql para o volume mysql_init (docker-entrypoint-initdb.d)
#   2. Deploy — MySQL importa na primeira inicialização
#   3. Defina RUN_MIGRATIONS=false se o dump já contém schema completo

# Opção B — Import via Git (temporário: pasta docker/seed):
#   1. IMPORT_DB_ON_START=true
#   2. FORCE_IMPORT_DB=true
#   3. IMPORT_DB_FILE=/opt/seed/backup.sql
#   4. IMPORT_STORAGE_DIR=/opt/seed/public
#   5. RUN_MIGRATIONS=false
#   6. Redeploy (rebuild)
#   7. Depois: FORCE_IMPORT_DB=false e IMPORT_DB_ON_START=false
#   8. Na próxima alteração: apagar docker/seed do repositório

# Opção C — Manual via terminal Coolify:
#   docker exec -i <container_mysql> mysql -u semel -p<PASSWORD> semel < backup.sql

RUN_MIGRATIONS=true
IMPORT_DB_ON_START=false
FORCE_IMPORT_DB=false
IMPORT_DB_FILE=/opt/seed/backup.sql
IMPORT_STORAGE_DIR=/opt/seed/public

DIRECTD_API_URL=https://apiv3.directd.com.br/api/CadastroReceitaPessoaFisica
DIRECTD_API_TSE_URL=https://apiv3.directd.com.br/api/TituloLocalVotacao
DIRECTD_API_TOKEN=

TRUSTED_PROXIES=*
SUPER_ADMIN_EMAIL=superadmin@example.com
SUPER_ADMIN_PASSWORD=

# Frontend build (opcional — domínio detectado em runtime se vazio)
VITE_MAIN_DOMAIN=
